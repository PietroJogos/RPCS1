// Gerado pelo CMake a partir de rpcs1.rc.in. Recursos do executável RPCS1 (informações de versão do Windows).
#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "PiStudio BR"
            VALUE "FileDescription", "RPCS1 - emulador original de PlayStation 1"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "RPCS1"
            VALUE "OriginalFilename", "RPCS1.exe"
            VALUE "ProductName", "RPCS1"
            VALUE "ProductVersion", "@PROJECT_VERSION@ (pré-alfa)"
            VALUE "LegalCopyright", "© 2026 PiStudio BR"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
